{
  "name": "dsh-task-toast",
  "version": "0.3.7",
  "description": "DSH 任务完成提醒：Windows 原生置顶卡片，显示本次/累计 token 与花费，可滚动查看最终回复。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "notification",
    "toast",
    "task",
    "token",
    "cost"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "icon.svg",
    "preview-native.png",
    "preview-dual.png"
  ],
  "scripts": {
    "test": "node tests/watcher.test.mjs",
    "test:host": "node tests/host.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxcxx2568/dsh-task-toast.git"
  },
  "homepage": "https://github.com/xxcxx2568/dsh-task-toast#readme",
  "bugs": {
    "url": "https://github.com/xxcxx2568/dsh-task-toast/issues"
  },
  "author": "xxcxx2568",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
